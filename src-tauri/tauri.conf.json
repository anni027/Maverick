{
  "identifier": "com.maverick.app",
  "productName": "Maverick",
  "version": "0.1.0",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Maverick",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  }
}